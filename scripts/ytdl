#!/bin/bash
# ytdl — descarga audio/vídeo de YouTube (y otros sitios) con yt-dlp.
# Uso: ytdl [orig|wav|mp3|mp4]        -> usa el enlace del portapapeles   (ytdl help para ayuda)
#      ytdl "<enlace>" [formato]      -> usa el enlace dado
# orig = audio original sin recomprimir (por defecto) · wav = WAV 24 bit/48 kHz
set -e
usage() {
  cat <<'HELP'
ytdl — descarga audio/vídeo de YouTube (y otros sitios) a ~/Downloads

CÓMO FUNCIONA
  1. Copia un enlace de YouTube (⌘C en la barra de direcciones).
  2. Escribe ytdl en Terminal. Lee el enlace de tu PORTAPAPELES, así que
     no hace falta pegarlo ni ponerlo entre comillas.

USO
  ytdl [formato]              descarga el enlace copiado en el portapapeles
  ytdl "<enlace>" [formato]   usa el enlace que le des (siempre entre comillas)
  ytdl help                   muestra esta ayuda (también: -h, --help)
  ytdl update                 actualiza ytdl y yt-dlp (también: upgrade)

FORMATOS
  orig   audio original sin recomprimir, la mejor calidad disponible
         (.webm/Opus o .m4a). Es el formato por defecto.
  wav    WAV 24 bit / 48 kHz, listo para Logic/Ableton/sampling
  mp3    MP3 de máxima calidad (VBR ~245 kbps), con metadatos
  mp4    vídeo MP4 (H.264 + AAC, se abre en QuickTime y editores; hasta 1080p)

EJEMPLOS
  ytdl                        audio original del enlace copiado
  ytdl wav                    lo mismo, pero a WAV
  ytdl "https://youtu.be/XXXXXXXXXXX" mp3

NOTAS
  · Al terminar abre Finder con el archivo seleccionado.
  · Solo descarga el vídeo del enlace, no la lista de reproducción.
  · Se actualiza solo.
    Desactivar: YTDL_NO_UPDATE=1 ytdl   ·   Manual: ytdl update
HELP
}

case "$1" in
  help|-h|--help) usage; exit 0 ;;
  update|upgrade) brew update && exec brew upgrade jdevesablanco/tap/ytdl yt-dlp ;;
  orig|wav|mp3|mp4|"") URL="$(pbpaste)"; FMT="${1:-orig}" ;;
  *) URL="$1"; FMT="${2:-orig}" ;;
esac
# Auto-actualización: como mucho una vez al día (desactivar: YTDL_NO_UPDATE=1)
STAMP="$HOME/.cache/ytdl-lastcheck"
if [ -z "$YTDL_NO_UPDATE" ] && command -v brew >/dev/null 2>&1 \
   && { [ ! -f "$STAMP" ] || [ -n "$(find "$STAMP" -mtime +0 2>/dev/null)" ]; }; then
  mkdir -p "$HOME/.cache" && touch "$STAMP"
  echo "Comprobando actualizaciones…"
  if brew update -q >/dev/null 2>&1 && brew outdated --quiet jdevesablanco/tap/ytdl yt-dlp 2>/dev/null | grep -q .; then
    echo "Actualizando ytdl y yt-dlp…"
    brew upgrade jdevesablanco/tap/ytdl yt-dlp >/dev/null 2>&1 || true
    exec "$(command -v ytdl)" "$@"
  fi
fi

case "$URL" in http*) ;; *)
  printf '%s\n' "No hay ningún enlace de YouTube copiado en el portapapeles (ytdl lo lee de ahí)." \
    "Copia primero un enlace, o usa: ytdl \"<enlace>\"" "Ahora tienes copiado: ${URL:0:60}"
  exit 1 ;;
esac
echo "Descargando: $URL ($FMT)"
cd ~/Downloads
TMP="$(mktemp)"
args=(--no-playlist -o "%(title)s.%(ext)s")
case "$FMT" in
  mp4) args+=(-S "vcodec:h264,res,acodec:m4a" -f "bv*+ba/b" --merge-output-format mp4) ;;
  mp3) args+=(-x --audio-format mp3 --audio-quality 0 --embed-metadata) ;;
  wav) args+=(-f ba) ;;
  *)   args+=(-f ba --embed-metadata) ;;
esac
if ! yt-dlp "${args[@]}" --print-to-file after_move:filepath "$TMP" "$URL"; then
  echo "Falló la descarga. Actualizando yt-dlp y reintentando una vez…"
  brew upgrade yt-dlp >/dev/null 2>&1 || true
  yt-dlp "${args[@]}" --print-to-file after_move:filepath "$TMP" "$URL"
fi
OUT="$(tail -n 1 "$TMP")"; rm -f "$TMP"
case "$OUT" in /*) ;; *) OUT="$PWD/$OUT" ;; esac
if [ "$FMT" = "wav" ]; then
  ffmpeg -y -loglevel error -i "$OUT" -c:a pcm_s24le -ar 48000 "${OUT%.*}.wav" && rm -f "$OUT" && OUT="${OUT%.*}.wav"
fi
echo "Listo: $OUT"
open -R "$OUT"
